{
  "name": "quick-chat",
  "version": "0.2.0",
  "minElftiaVersion": "0.2.8",
  "kind": "app-extension",
  "permissions": [
    "host:local-channel"
  ],
  "displayName": "Quick Chat",
  "description": "Compact owner-scoped Local Channel conversation surface",
  "capabilities": {
    "provides": [
      {
        "id": "elftia.quick-chat",
        "version": "1.0.0",
        "target": "main",
        "cardinality": "single"
      }
    ]
  },
  "contributes": {
    "main": {
      "entry": "index.cjs",
      "requiredMajor": 2,
      "requiredMinor": 0,
      "builtAgainst": "2.0.0",
      "checksum": "sha512-ouNNTlTGf6jRAk9MF0wO+yfSQgFb7nQnqiC34WC0sCJph61jd5NMdiOz/BBgFBHst2tWEJAEG+ArWsiwVY0qEg=="
    },
    "quickChat": {
      "id": "default",
      "entry": "index.mjs",
      "execution": "dedicated-window-v1",
      "requiredMajor": 2,
      "requiredMinor": 0,
      "builtAgainst": "2.0.0",
      "window": {
        "defaultWidth": 400,
        "defaultHeight": 560,
        "minWidth": 320,
        "minHeight": 360,
        "maxWidth": 720,
        "maxHeight": 900
      },
      "checksum": "sha512-322tzhI+BNxxuuiL+IwiPAqdTJLTQPPwciFbn+wDb1KL35bAyTEF/Rg3Cdn/goon67oAbVWdHXQSBGWsfLNETA=="
    },
    "localChannels": [
      {
        "id": "default",
        "displayName": "Quick Chat",
        "targetAgentId": "builtin-elftia-clawia",
        "exposeToAgent": true
      }
    ]
  }
}
