{
  "name": "quick-chat",
  "version": "0.1.2",
  "minElftiaVersion": "0.2.8",
  "kind": "app-extension",
  "permissions": [
    "host:local-channel"
  ],
  "displayName": "Quick Chat",
  "description": "Compact owner-scoped Local Channel conversation surface",
  "capabilities": {
    "provides": [
      {
        "id": "elftia.quick-chat",
        "version": "1.0.0",
        "target": "main",
        "cardinality": "single"
      }
    ]
  },
  "contributes": {
    "main": {
      "entry": "index.cjs",
      "requiredMajor": 1,
      "requiredMinor": 58,
      "builtAgainst": "1.58.0",
      "checksum": "sha512-tJ9rEeUY4g3XzdfkHPVD/tqlwpdhiHSBKUbsfXpqkQQvGe6aijGQrlbcTx+6TS+cXKeLI7nHuJDJz0Lao0tCxw=="
    },
    "quickChat": {
      "id": "default",
      "entry": "index.mjs",
      "execution": "dedicated-window-v1",
      "requiredMajor": 1,
      "requiredMinor": 58,
      "builtAgainst": "1.58.0",
      "window": {
        "defaultWidth": 400,
        "defaultHeight": 560,
        "minWidth": 320,
        "minHeight": 360,
        "maxWidth": 720,
        "maxHeight": 900
      },
      "checksum": "sha512-e32a6JwnGTX0KhdBj11RxKP1egifd2p9q12sDdzau84fYLXfHueR2DPizsFXazqsdCUTdyQnVY2Ka/sugo3IDw=="
    },
    "localChannels": [
      {
        "id": "default",
        "displayName": "Quick Chat",
        "targetAgentId": "builtin-elftia-clawia",
        "exposeToAgent": true
      }
    ]
  }
}
