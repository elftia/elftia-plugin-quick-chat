{
  "name": "quick-chat",
  "version": "0.1.0",
  "kind": "app-extension",
  "permissions": [
    "host:local-channel"
  ],
  "displayName": "Quick Chat",
  "description": "Compact owner-scoped Local Channel conversation surface",
  "capabilities": {
    "provides": [
      {
        "id": "elftia.quick-chat",
        "version": "1.0.0",
        "target": "main",
        "cardinality": "single"
      }
    ]
  },
  "contributes": {
    "main": {
      "entry": "index.cjs",
      "requiredMajor": 1,
      "requiredMinor": 58,
      "builtAgainst": "1.58.0",
      "checksum": "sha512-0kNv4MA8Px9+pV9E7NyAno/F127WxxYT6t5tr6TwN5oK3kSZHwFGa+jmWjlJ70ca1fWi+Sl4iRKB8FYAvWRFuA=="
    },
    "quickChat": {
      "id": "default",
      "entry": "index.mjs",
      "execution": "dedicated-window-v1",
      "requiredMajor": 1,
      "requiredMinor": 58,
      "builtAgainst": "1.58.0",
      "window": {
        "defaultWidth": 380,
        "defaultHeight": 520,
        "minWidth": 320,
        "minHeight": 360,
        "maxWidth": 720,
        "maxHeight": 900
      },
      "checksum": "sha512-R0zg0xIwpKcbHisaVTsq6yVB2ZJQHR3j5Teg9N+wv0kmKGG7EJmiHGjlSIXl8zaPQ5Xc9V3//TWzjhsO5r38Xw=="
    },
    "localChannels": [
      {
        "id": "default",
        "displayName": "Quick Chat",
        "targetAgentId": "builtin-elftia-clawia",
        "exposeToAgent": true
      }
    ]
  }
}
